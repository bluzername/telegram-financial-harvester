# Telegram API credentials
# Get these from https://my.telegram.org -> API Development Tools
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+1234567890

# Channels for telegram_export.py: comma separated usernames, t.me links or
# numeric IDs (channels use the -100 prefix, e.g. -1001234567890)
TARGET_CHANNELS=some_public_channel,-1001234567890

# =============================================================================
# Signal pipeline (pipeline.py)
# =============================================================================

# Numeric ID of the channel to harvest signals from (override with --channel)
TARGET_CHANNEL=-1001234567890

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for parsing (optional; default claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-5

# Checklister webhook: URL and the key matching POLITICIAN_WEBHOOK_API_KEY there
CHECKLISTER_WEBHOOK_URL=https://your-app.vercel.app/api/politician/signals
CHECKLISTER_API_KEY=your_webhook_api_key
